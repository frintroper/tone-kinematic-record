simulations/jerk_cycle.py
python

import numpy as np
import matplotlib.pyplot as plt

def iterate(j0, steps=15):
    traj = [j0]
    j = j0
    for _ in range(steps):
        j = 1.0 / j
        traj.append(j)
    return traj

starts = [3.0, 0.5, -1.5, 2.0, -0.25]
plt.figure(figsize=(9,5))
for s in starts:
    plt.plot(iterate(s), marker='o', label=f'start {s}')
plt.axhline(1, color='green', ls='--', label='+1')
plt.axhline(-1, color='red', ls='--', label='-1')
plt.xlabel('iteration')
plt.ylabel('j')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig('../figures/jerk_cycle.png')
print("jerk_cycle.png written")

simulations/exponent_collapse.py
python

import numpy as np
import matplotlib.pyplot as plt

steps = 50
exponent_without = np.full(steps, 2.25) + np.random.normal(0, 0.01, steps)
exponent_with = np.concatenate(([2.25], np.full(steps-1, 2.0)))

plt.figure(figsize=(9,5))
plt.plot(exponent_without, label='without inversion (~2.25)', color='orange')
plt.plot(exponent_with, label='with jerk inversion (=2)', color='blue')
plt.xlabel('step')
plt.ylabel('exponent')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig('../figures/exponent_collapse.png')
print("exponent_collapse.png written")

simulations/lean_truncation.py
python

import numpy as np
import matplotlib.pyplot as plt

def step(r, j, mode):
    if mode == "tone":
        j = 1.0 / j
        r *= 0.6 * abs(j - 1.0) + 0.05
        r = max(r, 0.0)
    else:
        r = max(r + 0.02 * np.random.randn(), 0.5)
    return r, j

def run(mode, steps=40):
    r, j = 1.0, 2.0
    hist = [r]
    for _ in range(steps):
        r, j = step(r, j, mode)
        hist.append(r)
    return hist

np.random.seed(42)
plt.figure(figsize=(9,5))
plt.plot(run("zfc"), label='ZFC/Lean residual', color='orange', ls='--')
plt.plot(run("tone"), label='TONE inversion', color='blue')
plt.axhline(0, color='green', ls=':', label='O(1)')
plt.xlabel('steps')
plt.ylabel('residual debt')
plt.legend()
plt.grid(True)
plt.tight_layout()
plt.savefig('../figures/lean_truncation.png')
print("lean_truncation.png written")

